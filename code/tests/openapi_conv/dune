; The APIs of the [routes.json] and [query_params.json] fixtures, as the converter generates them
; (unformatted), committed so that the tests run them and the compiler checks them. The golden tests
; of [test.ml] run the converter and check that it still generates them.

(library
 (name fixture_apis)
 (wrapped false)
 (modules
  query_params_api_components
  query_params_api_components_shade
  query_params_api_params
  routes_api_alerts
  routes_api_colors
  routes_api_components
  routes_api_items
  routes_api_packages)
 (flags
  (:standard -w -27-67))
 (libraries brtl containers openapi)
 (preprocess
  (pps
   ppx_deriving.eq
   ppx_deriving.make
   ppx_deriving.show
   ppx_deriving_yojson)))

(test
 (name test)
 (modules test)
 (libraries brtl containers fixture_apis openapi_conv oth unix uri uuidm)
 (deps
  integer_enum.json
  path_param_not_in_template.json
  query_params.json
  required_array_default.json
  routes.json
  undeclared_template_param.json
  unsupported_array_default.json))
