module List = struct
  module Parameters = struct
    module Color = struct
      let t_of_yojson = function
        | `String "green" -> Ok `Green
        | `String "red" -> Ok `Red
        | json -> Error ("Unknown value: " ^ Yojson.Safe.pretty_to_string json)

      let t_to_yojson = function
        | `Green -> `String "green"
        | `Red -> `String "red"

      type t =
        ([ `Green
         | `Red
         ]
        [@of_yojson t_of_yojson] [@to_yojson t_to_yojson])
      [@@deriving show, eq]
    end

    module Colors = struct
      module Items = struct
        let t_of_yojson = function
          | `String "green" -> Ok `Green
          | `String "red" -> Ok `Red
          | json -> Error ("Unknown value: " ^ Yojson.Safe.pretty_to_string json)

        let t_to_yojson = function
          | `Green -> `String "green"
          | `Red -> `String "red"

        type t =
          ([ `Green
           | `Red
           ]
          [@of_yojson t_of_yojson] [@to_yojson t_to_yojson])
        [@@deriving show, eq]
      end

      type t = Items.t list [@@deriving show, eq]
    end

    module Has = struct
      module V0 = struct
        type t = string [@@deriving show, eq]
      end

      module V1 = struct
        module Items = struct
          let t_of_yojson = function
            | `String "patch" -> Ok `Patch
            | json -> Error ("Unknown value: " ^ Yojson.Safe.pretty_to_string json)

          let t_to_yojson = function
            | `Patch -> `String "patch"

          type t = ([ `Patch ][@of_yojson t_of_yojson] [@to_yojson t_to_yojson])
          [@@deriving show, eq]
        end

        type t = Items.t list [@@deriving show, eq]
      end

      type t =
        | V0 of V0.t
        | V1 of V1.t
      [@@deriving show, eq]
    end

    module Pick = struct
      module V0 = struct
        type t = int [@@deriving show, eq]
      end

      module V1 = struct
        type t = bool [@@deriving show, eq]
      end

      module V2 = struct
        type t = Query_params_api_components.Shade.t list [@@deriving show, eq]
      end

      type t =
        | V0 of V0.t
        | V1 of V1.t
        | V2 of V2.t
      [@@deriving show, eq]
    end

    module Shades = struct
      type t = Query_params_api_components.Shade.t list [@@deriving show, eq]
    end

    module Tags = struct
      type t = string list [@@deriving show, eq]
    end

    type t = {
      big : int64 option; [@default None]
      big_level : int64 option; [@default None]
      color : Color.t; [@default `Red]
      colors : Colors.t option; [@default None]
      count : int; [@default 10]
      cursor : string option; [@default None]
      environment : string option; [@default Some "none"]
      flag : bool; [@default false]
      has : Has.t option; [@default None]
      id : string;
      level : int option; [@default None]
      name : string option; [@default None]
      pick : Pick.t option; [@default None]
      shade : Query_params_api_components.Shade.t option; [@default None]
      shades : Shades.t option; [@default None]
      tags : Tags.t; [@default [ "a" ]]
    }
    [@@deriving make, show, eq]
  end

  let route base_route =
    let open Brtl_rtng.Route.Query in
    let open Brtl_rtng.Route in
    base_route
    /? uuid "id"
    /? option (string "name")
    /? option (string "cursor")
    /? option_default (Some "none") (option (string "environment"))
    /? option_default 10 (int "count")
    /? option (ud "big" CCInt64.of_string)
    /? option
         (ud
            "level"
            (fun value ->
               match CCInt.of_string value with
               | Some 1 -> Some 1
               | Some 2 -> Some 2
               | _ -> None
              : string -> int option))
    /? option
         (ud
            "big_level"
            (fun value ->
               match CCInt64.of_string value with
               | Some 10000000000L -> Some 10000000000L
               | Some 20000000000L -> Some 20000000000L
               | _ -> None
              : string -> int64 option))
    /? option_default false (bool "flag")
    /? option_default
         `Red
         (ud "color" (fun value -> CCResult.to_opt (Parameters.Color.t_of_yojson (`String value))))
    /? option
         (ud "shade" (fun value ->
              CCResult.to_opt (Query_params_api_components.Shade.t_of_yojson (`String value))))
    /? option_default [ "a" ] (array (string "tags"))
    /? option
         (array
            (ud "colors" (fun value ->
                 CCResult.to_opt (Parameters.Colors.Items.t_of_yojson (`String value)))))
    /? option
         (array
            (ud "shades" (fun value ->
                 CCResult.to_opt (Query_params_api_components.Shade.t_of_yojson (`String value)))))
    /? option
         (ud_array "has" (fun values ->
              CCOption.choice
                [
                  CCOption.map
                    (fun v -> Parameters.Has.V0 v)
                    (match values with
                    | value :: [] -> CCOption.return value
                    | _ -> None);
                  CCOption.map
                    (fun v -> Parameters.Has.V1 v)
                    (CCOption.sequence_l
                       (CCList.map
                          (fun value ->
                            CCResult.to_opt (Parameters.Has.V1.Items.t_of_yojson (`String value)))
                          values));
                ]))
    /? option
         (ud_array "pick" (fun values ->
              CCOption.choice
                [
                  CCOption.map
                    (fun v -> Parameters.Pick.V0 v)
                    (match values with
                    | value :: [] -> CCInt.of_string value
                    | _ -> None);
                  CCOption.map
                    (fun v -> Parameters.Pick.V1 v)
                    (match values with
                    | value :: [] -> bool_of_string_opt value
                    | _ -> None);
                  CCOption.map
                    (fun v -> Parameters.Pick.V2 v)
                    (CCOption.sequence_l
                       (CCList.map
                          (fun value ->
                            CCResult.to_opt
                              (Query_params_api_components.Shade.t_of_yojson (`String value)))
                          values));
                ]))

  module Responses = struct
    module OK = struct end

    type t = [ `OK ] [@@deriving show, eq]

    let t = [ ("200", fun _ -> Ok `OK) ]
  end

  let url = "/params"

  let make params =
    Openapi.Request.make
      ~headers:[]
      ~url_params:[]
      ~query_params:
        (let open Openapi.Request.Var in
         let open Parameters in
         [
           ("id", Var (params.id, String));
           ("name", Var (params.name, Option String));
           ("cursor", Var (params.cursor, Option String));
           ("environment", Var (params.environment, Option String));
           ("count", Var (params.count, Int));
           ("big", Var (params.big, Option Int64));
           ("level", Var (params.level, Option Int));
           ("big_level", Var (params.big_level, Option Int64));
           ("flag", Var (params.flag, Bool));
           ("color", Var (params.color, Enum Color.t_to_yojson));
           ("shade", Var (params.shade, Option (Enum Query_params_api_components.Shade.t_to_yojson)));
           ("tags", Var (params.tags, Array String));
           ("colors", Var (params.colors, Option (Array (Enum Colors.Items.t_to_yojson))));
           ( "shades",
             Var (params.shades, Option (Array (Enum Query_params_api_components.Shade.t_to_yojson)))
           );
           ( "has",
             match params.has with
             | Some (Has.V0 v) -> Var (v, String)
             | Some (Has.V1 v) -> Var (v, Array (Enum Has.V1.Items.t_to_yojson))
             | None -> Var ((), Null) );
           ( "pick",
             match params.pick with
             | Some (Pick.V0 v) -> Var (v, Int)
             | Some (Pick.V1 v) -> Var (v, Bool)
             | Some (Pick.V2 v) ->
                 Var (v, Array (Enum Query_params_api_components.Shade.t_to_yojson))
             | None -> Var ((), Null) );
         ])
      ~url
      ~responses:Responses.t
      `Get
end
