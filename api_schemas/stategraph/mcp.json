            "base_branch": {
              "type": "string"
            },
            "base_sha": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "merged_at": {
              "type": "string"
            },
            "merged_sha": {
              "type": "string"
            },
            "pull_number": {
              "type": "integer"
            },
            "sha": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "username": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "runs": {
          "description": "The 50 most recent runs (work manifests) of the pull request, newest first.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "base_sha": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "completed_at": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "run_kind": {
                "type": "string"
              },
              "run_type": {
                "type": "string"
              },
              "sha": {
                "type": "string"
              },
              "state": {
                "$ref": "../terrat/api.json#/components/schemas/work-manifest-state"
              },
              "username": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "truncated": {
          "description": "True when a list holds only its first rows: 50 runs, or 500 rows for any other list.",
          "type": "boolean"
        }
      },
      "required": [
        "dirspace_results",
        "runs",
        "truncated"
      ],
      "type": "object"
    },
    "query-arguments": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "description": "The next_page value of a previous result of the same statement.",
          "type": "string"
        },
        "sql": {
          "description": "One read-only SELECT statement. Add ORDER BY to get next_page cursors. Without LIMIT the server returns 20 rows; the maximum is 1000.",
          "type": "string"
        }
      },
      "required": [
        "sql"
      ],
      "type": "object"
    },
    "query-output": {
      "additionalProperties": false,
      "properties": {
        "next_page": {
          "description": "Pass this as page to read the next rows. Absent when there are no more rows or the statement has no ORDER BY.",
          "type": "string"
        },
        "note": {
          "description": "Why the result is incomplete and what to change.",
          "type": "string"
        },
        "row_count": {
          "description": "The number of rows in rows.",
          "type": "integer"
        },
        "rows": {
          "items": {},
          "type": "array"
        },
        "truncated": {
          "description": "True when more rows match than rows holds.",
          "type": "boolean"
        }
      },
      "required": [
        "rows",
        "row_count",
        "truncated"
      ],
      "type": "object"
    },
