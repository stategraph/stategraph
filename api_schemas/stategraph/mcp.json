        "capabilities": {
          "$ref": "#/definitions/server-capabilities"
        },
        "instructions": {
          "description": "Guidance for the model on how to use the server.",
          "type": "string"
        },
        "protocolVersion": {
          "description": "The MCP version that the server uses for this client.",
          "type": "string"
        },
        "serverInfo": {
          "$ref": "#/definitions/server-info"
        }
      },
      "required": [
        "protocolVersion",
        "capabilities",
        "serverInfo"
      ],
      "type": "object"
    },
    "list-changed-capability": {
      "additionalProperties": false,
      "description": "A server capability. listChanged is true when the server sends notifications when the list changes.",
      "properties": {
        "listChanged": {
          "type": "boolean"
        }
      },
      "required": [
        "listChanged"
      ],
      "type": "object"
    },
    "list-states-arguments": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "page": {
          "description": "The next_page value of a previous result.",
          "type": "string"
        },
        "q": {
          "description": "A filter on the state name.",
          "type": "string"
        },
        "tenant_id": {
          "description": "The tenant. Required when the user is in more than one tenant.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "list-states-output": {
      "additionalProperties": false,
      "properties": {
        "next_page": {
          "type": "string"
        },
        "states": {
          "$ref": "api.json#/components/schemas/tenant-states"
        },
        "tenant_id": {
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "states"
      ],
      "type": "object"
    },
    "pull-request-arguments": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "description": "The VCS provider. The default is github.",
          "enum": [
            "github",
            "gitlab"
          ],
          "type": "string"
        },
        "pull_number": {
          "description": "The number of the pull request or merge request.",
          "minimum": 1,
          "type": "integer"
        },
        "repo": {
          "description": "The repository as owner/name. For GitLab, owner is the group path.",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "pull_number"
      ],
      "type": "object"
    },
    "pull-request-gates-output": {
      "additionalProperties": false,
      "properties": {
        "approvals": {
          "description": "The gate approvals of the pull request.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "approver": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              },
              "sha": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "gates": {
          "description": "The gates of the pull request, for each commit and dirspace.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "created_at": {
                "type": "string"
              },
              "dir": {
                "type": "string"
              },
              "gate": {},
              "name": {
                "type": "string"
              },
              "sha": {
                "type": "string"
              },
              "workspace": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "truncated": {
          "description": "True when a list holds only its first rows: 50 runs, or 500 rows for any other list.",
          "type": "boolean"
        }
      },
      "required": [
        "approvals",
        "gates",
        "truncated"
      ],
      "type": "object"
    },
    "pull-request-locks-output": {
      "additionalProperties": false,
      "properties": {
        "locks": {
          "description": "The dirspace locks in the repository. held_by_this_pull_request tells which pull request holds each lock. A lock held by another pull request on a dirspace that this pull request changes blocks its apply.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "branch_target": {
                "type": "string"
              },
              "held_by_this_pull_request": {
                "type": "boolean"
              },
              "holder_pull_number": {
                "type": "integer"
              },
              "path": {
                "type": "string"
              },
              "workspace": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "workspace"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "truncated": {
          "description": "True when a list holds only its first rows: 50 runs, or 500 rows for any other list.",
          "type": "boolean"
        }
      },
      "required": [
        "locks",
        "truncated"
      ],
      "type": "object"
    },
    "pull-request-runs-output": {
      "additionalProperties": false,
      "properties": {
        "dirspace_results": {
          "description": "For each run, the number of dirspaces that succeeded and failed.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "dirspaces": {
                "type": "integer"
              },
              "success": {
                "type": "boolean"
              },
              "work_manifest": {
                "type": "string"
              }
            },
            "required": [
              "work_manifest"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "pull_request": {
          "additionalProperties": false,
          "description": "The pull request: state, head sha, base sha, branches, title, author. Absent when Orchestration has no record of it. A run whose sha is not the head sha ran on an older commit.",
