          "type": "string"
        },
        "method": {
          "description": "The MCP method, e.g. tools/call.",
          "type": "string"
        },
        "params": {
          "description": "The parameters of the method. Their shape depends on the method."
        }
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "type": "object"
    },
    "request-id": {
      "description": "The id of a JSON-RPC request, echoed in its response.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    },
