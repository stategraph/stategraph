{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "blast-radius-arguments": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "description": "The address of the instance, e.g. aws_vpc.main or module.net.aws_subnet.a[0].",
          "type": "string"
        },
        "limit": {
          "description": "The maximum number of nodes.",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "max_depth": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "state_id": {
          "type": "string"
        }
      },
      "required": [
        "state_id",
        "address"
      ],
      "type": "object"
    },
    "blast-radius-output": {
      "$ref": "api.json#/components/schemas/instance-blast-radius"
    },
    "empty-object": {
      "additionalProperties": false,
      "description": "An object with no properties: the arguments of a tool that takes none, and the result of ping.",
      "properties": {},
      "type": "object"
    },
    "error": {
      "additionalProperties": false,
      "description": "A JSON-RPC error.",
      "properties": {
        "code": {
          "description": "The JSON-RPC error code: -32700 parse error, -32600 invalid request, -32601 method not found, -32602 invalid params, -32603 internal error.",
          "type": "integer"
        },
        "message": {
          "description": "A human-readable message.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "get-doc-arguments": {
      "additionalProperties": false,
      "properties": {
        "offset": {
          "description": "The byte offset to read from. Use next_offset of the previous result.",
          "minimum": 0,
          "type": "integer"
        },
        "url": {
          "description": "The URL or the path of the page, e.g. https://stategraph.com/docs/orchestration or /docs/orchestration.",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "get-doc-output": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "description": "The Markdown of the page from offset, at most 32 KB.",
          "type": "string"
        },
        "docs_version": {
          "description": "The version of the Stategraph server whose image holds these docs. Absent when the docs come from another URL, such as stategraph.com, which has the docs of the latest release.",
          "type": "string"
        },
        "next_offset": {
          "description": "The offset of the next part. Absent when content holds the end of the page.",
          "type": "integer"
        },
        "offset": {
          "description": "The byte offset that this part starts at.",
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "total_bytes": {
          "description": "The size of the whole text, in bytes.",
          "type": "integer"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "content",
        "offset",
        "total_bytes"
      ],
      "type": "object"
    },
    "get-run-arguments": {
      "additionalProperties": false,
      "properties": {
        "failed_only": {
          "description": "Return only the dirspaces and steps that failed.",
          "type": "boolean"
        },
        "provider": {
          "description": "The VCS provider. The default is github.",
          "enum": [
            "github",
            "gitlab"
          ],
          "type": "string"
        },
        "run_id": {
          "description": "The id of the run (work manifest), from list_pull_request_runs.",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "type": "object"
    },
    "get-run-output": {
      "additionalProperties": false,
      "properties": {
        "dirspaces": {
          "description": "The result of each dirspace, failures first.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "success": {
                "type": "boolean"
              },
              "workspace": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "workspace"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "run": {
          "additionalProperties": false,
          "description": "The run. Absent when it does not exist or is not in a tenant of the user.",
          "properties": {
            "base_sha": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "completed_at": {
              "type": "string"
            },
            "created_at": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "pull_number": {
              "type": "integer"
            },
            "repo_name": {
              "type": "string"
            },
            "repo_owner": {
              "type": "string"
            },
            "run_kind": {
              "type": "string"
            },
            "run_type": {
              "type": "string"
            },
            "sha": {
              "type": "string"
            },
            "state": {
              "$ref": "../terrat/api.json#/components/schemas/work-manifest-state"
            },
            "tag_query": {
              "type": "string"
            },
            "username": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "type": "object"
        },
        "steps": {
          "description": "The workflow steps without their output. Read an output with get_step_output.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "created_at": {
                "type": "string"
              },
              "idx": {
                "type": "integer"
              },
              "ignore_errors": {
                "type": "boolean"
              },
              "scope": {
                "$ref": "../terrat/api.json#/components/schemas/workflow-step-output-scope"
              },
              "step": {
                "type": "string"
              },
              "success": {
                "type": "boolean"
              }
            },
            "required": [
              "idx",
              "step"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "truncated": {
          "description": "True when a list holds only its first rows: 50 runs, or 500 rows for any other list.",
          "type": "boolean"
        }
      },
      "required": [
        "dirspaces",
        "steps",
        "truncated"
      ],
      "type": "object"
    },
    "get-step-output-arguments": {
      "additionalProperties": false,
      "properties": {
        "idx": {
          "description": "The idx of the step, from get_run.",
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "description": "The byte offset to read from. Use next_offset of the previous result.",
          "minimum": 0,
          "type": "integer"
        },
        "run_id": {
          "description": "The id of the run (work manifest).",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "idx"
      ],
      "type": "object"
    },
    "get-step-output-output": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "additionalProperties": {},
          "description": "The scalar fields of the step payload, e.g. has_changes.",
          "type": "object"
        },
        "next_offset": {
          "description": "The offset of the next part. Absent when text holds the end.",
          "type": "integer"
        },
        "offset": {
          "description": "The byte offset that this part starts at.",
          "type": "integer"
        },
        "step": {
          "additionalProperties": false,
          "description": "The step: idx, step, scope, success. Absent when the step does not exist.",
          "properties": {
            "idx": {
              "type": "integer"
            },
            "ignore_errors": {
              "type": "boolean"
            },
            "scope": {
              "$ref": "../terrat/api.json#/components/schemas/workflow-step-output-scope"
            },
            "step": {
              "type": "string"
            },
            "success": {
              "type": "boolean"
            }
          },
          "required": [
            "idx",
            "step"
          ],
          "type": "object"
        },
        "text": {
          "description": "The output of the step from offset, at most 32 KB. Values that the tool marked sensitive are masked as it printed them.",
          "type": "string"
        },
        "text_field": {
          "description": "The payload field that text is read from: plan, text, or the first other text field.",
          "type": "string"
        },
        "total_bytes": {
          "description": "The size of the whole text, in bytes.",
          "type": "integer"
        }
      },
      "required": [
        "fields",
        "offset",
        "total_bytes"
      ],
      "type": "object"
    },
    "get-transaction-arguments": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "description": "The next_page value of a previous result, for more plan operations.",
          "type": "string"
        },
        "tx_id": {
          "type": "string"
        }
      },
      "required": [
        "tx_id"
      ],
      "type": "object"
    },
    "get-transaction-output": {
      "additionalProperties": false,
      "properties": {
        "next_page": {
          "type": "string"
        },
        "plan_operations": {
          "$ref": "api.json#/components/schemas/plan-operations"
        },
        "transaction": {
          "$ref": "api.json#/components/schemas/tx-detail"
        }
      },
      "required": [
        "transaction",
        "plan_operations"
      ],
      "type": "object"
    },
    "initialize-params": {
      "additionalProperties": {},
      "description": "The parameters of initialize.",
      "properties": {
        "protocolVersion": {
          "description": "The MCP version that the client asks for.",
          "type": "string"
        }
      },
      "type": "object"
    },
