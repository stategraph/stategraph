{
  "$ref": "#/definitions/run-result",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "reason-bad-request": {
      "additionalProperties": false,
      "description": "The server rejected an actuator request. \"id\" is the server error id; \"data\" is an optional human-readable detail message (e.g. the specific lock-merge conflict).",
      "properties": {
        "data": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "bad_request",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "reason-capability-denied": {
      "additionalProperties": false,
      "description": "A session or transaction capability check denied the run. \"denied\" carries the same structured reasons a synchronous capability check returns.",
      "properties": {
        "denied": {
          "$ref": "capability-denied.json#/definitions/response"
        },
        "kind": {
          "const": "capability_denied",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "denied"
      ],
      "type": "object"
    },
    "reason-client-create": {
      "additionalProperties": false,
      "description": "The API client could not be created (e.g. a malformed base URL). Reported only when reachable; a failure this early may instead be logged locally by the actuator.",
      "properties": {
        "kind": {
          "const": "client_create",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "reason-failed-apply": {
      "additionalProperties": false,
      "description": "[terraform apply] failed.",
      "properties": {
        "kind": {
          "const": "apply",
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "stdout",
        "stderr"
      ],
      "type": "object"
    },
    "reason-failed-transport-call": {
      "additionalProperties": false,
      "description": "An HTTP call to the server failed at the transport level.",
      "properties": {
        "kind": {
          "const": "call",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "reason-hcl-parse": {
      "additionalProperties": false,
      "description": "The HCL bundle could not be parsed.",
      "properties": {
        "kind": {
          "const": "hcl_parse",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "reason-import-id-unresolved": {
      "additionalProperties": false,
      "description": "The id of an import block keeps a module reference that the bundle root cannot resolve, so the run was refused before terraform ran. \"block\" is the to expression text of the import block; \"reference\" is the surviving module reference; \"detail\" says why.",
      "properties": {
        "block": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "kind": {
          "const": "import_id_unresolved",
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "block",
        "reference",
        "detail"
      ],
      "type": "object"
    },
    "reason-init": {
      "additionalProperties": false,
      "description": "[terraform init] failed.",
      "properties": {
        "kind": {
          "const": "init",
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "stdout",
        "stderr"
      ],
      "type": "object"
    },
    "reason-next-task-failed": {
      "additionalProperties": false,
      "description": "The server-side actuator/next task did not complete, so the actuator was never told what to do. \"state\" is the task's terminal state.",
      "properties": {
        "kind": {
          "const": "next_task_failed",
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/task-state"
        }
      },
      "required": [
        "kind",
        "state"
      ],
      "type": "object"
    },
    "reason-next-timeout": {
      "additionalProperties": false,
      "description": "The actuator gave up waiting for an actuator/next task to reach a terminal state. \"seconds\" is the bound it waited, from STATEGRAPH_ACTUATOR_NEXT_TIMEOUT_SECONDS.",
      "properties": {
        "kind": {
          "const": "next_timeout",
          "type": "string"
        },
        "seconds": {
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "seconds"
      ],
      "type": "object"
    },
    "reason-params-fetch": {
      "additionalProperties": false,
      "description": "Fetching the transaction parameters from the server failed.",
      "properties": {
        "kind": {
          "const": "params_fetch",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "reason-plan": {
      "additionalProperties": false,
      "description": "[terraform plan] failed.",
      "properties": {
        "kind": {
          "const": "plan",
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "stdout",
        "stderr"
      ],
      "type": "object"
    },
    "reason-preview-decode": {
      "additionalProperties": false,
      "description": "Base64-decoding the fetched preview plan failed. \"message\" is the underlying error.",
      "properties": {
        "kind": {
          "const": "preview_decode",
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    "reason-preview-fetch": {
      "additionalProperties": false,
      "description": "Fetching the preview plan from the server (during a commit) failed.",
      "properties": {
        "kind": {
          "const": "preview_fetch",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "reason-read": {
      "additionalProperties": false,
      "description": "Reading a generated file (plan or state) failed.",
      "properties": {
        "kind": {
          "const": "read",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "reason-remote-state-address-unresolved": {
      "additionalProperties": false,
      "description": "A [terraform_remote_state] data source address names a variable or a local that does not resolve at plan time, so the run was refused before terraform ran. \"block\" is the address of the data source block; \"variable\" is the address that did not resolve; \"detail\" says why.",
      "properties": {
        "block": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "kind": {
          "const": "remote_state_address_unresolved",
          "type": "string"
        },
        "variable": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "block",
        "variable",
        "detail"
      ],
      "type": "object"
    },
    "reason-results-task-failed": {
      "additionalProperties": false,
      "description": "The server-side results-delivery task did not complete. \"state\" is the task's terminal state.",
      "properties": {
        "kind": {
          "const": "results_task_failed",
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/task-state"
        }
      },
      "required": [
        "kind",
        "state"
      ],
      "type": "object"
    },
    "reason-show-json": {
      "additionalProperties": false,
      "description": "[terraform show -json] failed.",
      "properties": {
        "kind": {
          "const": "show_json",
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "stdout",
        "stderr"
      ],
      "type": "object"
    },
    "reason-state-schema-placeholder-present": {
      "additionalProperties": false,
      "description": "A state in the transaction's subgraph stores the sensitive-value placeholder in its HCL, so the upgrade refused the state instead of writing the placeholder back as the value. \"state\" names the state; the run was refused before terraform ran.",
      "properties": {
        "kind": {
          "const": "state_schema_placeholder_present",
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/state-schema-upgrade-state"
        }
      },
      "required": [
        "kind",
        "state"
      ],
      "type": "object"
    },
    "reason-state-schema-remote-module-missing": {
      "additionalProperties": false,
      "description": "A state in the transaction's subgraph calls a remote module whose body this server does not hold, so the upgrade refused the state instead of upgrading an incomplete configuration. \"state\" names the state; \"source\" names the module it calls and \"version\" is the version that call pins, absent when it pins none.",
      "properties": {
        "kind": {
          "const": "state_schema_remote_module_missing",
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/state-schema-upgrade-state"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "state",
        "source"
      ],
      "type": "object"
    },
    "reason-state-schema-upgrade-failed": {
      "additionalProperties": false,
      "description": "The state schema upgrade transaction this run waited on failed, so the run failed. \"upgrade_tx_id\" is that transaction.",
      "properties": {
        "kind": {
          "const": "state_schema_upgrade_failed",
          "type": "string"
        },
        "upgrade_tx_id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "upgrade_tx_id"
      ],
      "type": "object"
    },
    "reason-state-schema-upgrade-rounds-exhausted": {
      "additionalProperties": false,
      "description": "The run re-ran the state schema upgrade protocol until its budget was spent and the states it serves were still behind, so it failed. \"rounds\" is how many upgrade rounds this run populated itself.",
      "properties": {
        "kind": {
          "const": "state_schema_upgrade_rounds_exhausted",
          "type": "string"
        },
        "rounds": {
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "rounds"
      ],
      "type": "object"
    },
    "reason-state-schema-upgrade-timeout": {
      "additionalProperties": false,
      "description": "The run waited for a state schema upgrade longer than its bound, so it failed. \"seconds\" is the bound it waited.",
      "properties": {
        "kind": {
          "const": "state_schema_upgrade_timeout",
          "type": "string"
        },
        "seconds": {
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "seconds"
      ],
      "type": "object"
    },
    "reason-temp-dir": {
      "additionalProperties": false,
      "description": "A temporary working directory could not be created.",
      "properties": {
        "kind": {
          "const": "temp_dir",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "reason-tf-binary-not-found": {
      "additionalProperties": false,
      "description": "The OpenTofu/Terraform binary was not found. \"tf\" is the command that was attempted.",
      "properties": {
        "kind": {
          "const": "tf_binary_not_found",
          "type": "string"
        },
        "tf": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "tf"
      ],
      "type": "object"
    },
    "reason-tx-conflict": {
      "additionalProperties": false,
      "description": "The transaction conflicts with another transaction that modified overlapping resources.",
      "properties": {
        "conflicting_tx_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "const": "tx_conflict",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "conflicting_tx_ids"
      ],
      "type": "object"
    },
    "reason-tx-invalid-state": {
      "additionalProperties": false,
      "description": "The transaction was not in the state the operation requires (preview requires 'open'; commit requires 'previewed').",
      "properties": {
        "actual_state": {
          "type": "string"
        },
        "expected_state": {
          "type": "string"
        },
        "kind": {
          "const": "tx_invalid_state",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "expected_state"
      ],
      "type": "object"
    },
    "reason-tx-schema-version-mismatch": {
      "additionalProperties": false,
      "description": "The transaction recorded a state schema version that differs from this server's, so the apply was refused before terraform ran. \"planned_schema_version\" is the version the transaction recorded when it was created; \"server_schema_version\" is this server's. Plan again in a new transaction.",
      "properties": {
        "kind": {
          "const": "tx_schema_version_mismatch",
          "type": "string"
        },
        "planned_schema_version": {
          "type": "integer"
        },
        "server_schema_version": {
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "planned_schema_version",
        "server_schema_version"
      ],
      "type": "object"
    },
    "reason-unauthorized": {
      "additionalProperties": false,
      "description": "The server rejected an actuator request as unauthorized.",
      "properties": {
        "kind": {
          "const": "unauthorized",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "reason-write": {
      "additionalProperties": false,
      "description": "Writing a bundle file failed. \"message\" is the underlying error.",
      "properties": {
        "kind": {
          "const": "write",
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    "run-failure": {
      "additionalProperties": false,
      "description": "A run failed. \"reason\" is the structured cause.",
      "properties": {
        "kind": {
          "const": "failure",
          "type": "string"
        },
        "reason": {
          "$ref": "#/definitions/run-failure-reason"
        },
        "stategraph_import_id_dropped": {
          "description": "The states whose import id expression could not be restored, one entry per undecodable row. Present only when the mapping was incomplete, in which case an internal name stands in its place in the captured output.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "type": "object"
    },
    "run-failure-reason": {
      "description": "One cause of an actuator-run failure. The \"kind\" discriminates the shape; terraform-phase failures (init/plan/show_json/apply) carry the captured stdout and stderr.",
      "oneOf": [
        {
          "$ref": "#/definitions/reason-tf-binary-not-found"
        },
        {
          "$ref": "#/definitions/reason-hcl-parse"
        },
        {
          "$ref": "#/definitions/reason-write"
        },
        {
          "$ref": "#/definitions/reason-init"
        },
        {
          "$ref": "#/definitions/reason-plan"
        },
        {
          "$ref": "#/definitions/reason-show-json"
        },
        {
          "$ref": "#/definitions/reason-failed-apply"
        },
        {
          "$ref": "#/definitions/reason-read"
        },
        {
          "$ref": "#/definitions/reason-temp-dir"
        },
        {
          "$ref": "#/definitions/reason-preview-fetch"
        },
        {
          "$ref": "#/definitions/reason-preview-decode"
        },
        {
          "$ref": "#/definitions/reason-params-fetch"
        },
        {
          "$ref": "#/definitions/reason-bad-request"
        },
        {
          "$ref": "#/definitions/reason-unauthorized"
        },
        {
          "$ref": "#/definitions/reason-failed-transport-call"
        },
        {
          "$ref": "#/definitions/reason-client-create"
        },
        {
          "$ref": "#/definitions/reason-next-task-failed"
        },
        {
          "$ref": "#/definitions/reason-next-timeout"
        },
        {
          "$ref": "#/definitions/reason-results-task-failed"
        },
        {
          "$ref": "#/definitions/reason-capability-denied"
        },
        {
          "$ref": "#/definitions/reason-tx-conflict"
        },
        {
          "$ref": "#/definitions/reason-tx-invalid-state"
        },
        {
          "$ref": "#/definitions/reason-remote-state-address-unresolved"
        },
        {
          "$ref": "#/definitions/reason-tx-schema-version-mismatch"
        },
        {
          "$ref": "#/definitions/reason-state-schema-placeholder-present"
        },
        {
          "$ref": "#/definitions/reason-state-schema-remote-module-missing"
        },
        {
          "$ref": "#/definitions/reason-state-schema-upgrade-failed"
        },
        {
          "$ref": "#/definitions/reason-state-schema-upgrade-rounds-exhausted"
        },
        {
          "$ref": "#/definitions/reason-state-schema-upgrade-timeout"
        },
        {
          "$ref": "#/definitions/reason-import-id-unresolved"
        }
      ]
    },
    "run-result": {
      "description": "The structured outcome of a single actuator run (preview or commit), stored as the run task's result so a client polling the task -- including a remote actuator the CLI never shares a process with -- learns the same success/failure detail the in-process actuator used to return directly. The \"kind\" discriminates success from failure.",
      "oneOf": [
        {
          "$ref": "#/definitions/run-success-preview"
        },
        {
          "$ref": "#/definitions/run-success-commit"
        },
        {
          "$ref": "#/definitions/run-failure"
        },
        {
          "$ref": "#/definitions/run-success-noop"
        }
      ]
    },
    "run-success-commit": {
      "additionalProperties": false,
      "description": "A commit run completed. \"state\" is the resulting Terraform state JSON; \"output\" is the apply output (vendor-rebranded).",
      "properties": {
        "kind": {
          "const": "success_commit",
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "state": {}
      },
      "required": [
        "kind",
        "state",
        "output"
      ],
      "type": "object"
    },
    "run-success-noop": {
      "additionalProperties": false,
      "description": "A preview run that had nothing to do, so no plan was produced and terraform was never run (RFD 584). Reached only by a transaction whose configuration did not change: such a plan still opens a transaction, carrying a single refresh entry, so that a data source whose RESULT moved is reachable. \"reason\" says which of the two ways it turned out there was nothing to plan.",
      "properties": {
        "kind": {
          "const": "success_noop",
          "type": "string"
        },
        "reason": {
          "description": "\"no_data_sources\": no state in the transaction declares a data source, so there is no result that could have moved. \"refresh_skipped\": the caller passed skip_data_source_refresh, so the data sources were not refreshed and nothing else in the transaction needs planning.",
          "enum": [
            "no_data_sources",
            "refresh_skipped"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "type": "object"
    },
    "run-success-preview": {
      "additionalProperties": false,
      "description": "A preview run completed. \"has_changes\" is the [tofu plan -detailed-exitcode] outcome; \"plan\" is the base64 binary plan; \"plan_json\" is the demangled plan JSON (demangled server-side from the actuator's mangled plan).",
      "properties": {
        "has_changes": {
          "type": "boolean"
        },
        "kind": {
          "const": "success_preview",
          "type": "string"
        },
        "plan": {
          "type": "string"
        },
        "plan_json": {}
      },
      "required": [
        "kind",
        "has_changes",
        "plan",
        "plan_json"
      ],
      "type": "object"
    },
    "state-schema-behind-state": {
      "additionalProperties": false,
      "description": "One state whose stored configuration is at an older Stategraph schema version than the server understands. Named well enough for an operator to find it: the id is unambiguous, the name and workspace are what they will recognise.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "workspace",
        "schema_version"
      ],
      "type": "object"
    },
    "state-schema-upgrade-state": {
      "additionalProperties": false,
      "description": "One state whose in-process schema upgrade was refused. Named well enough for an operator to find it: the id is unambiguous, the name and workspace are what they will recognise, and \"schema_version\" is the version the state is stuck at.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer"
        },
        "workspace": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "workspace",
        "schema_version"
      ],
      "type": "object"
    },
    "task-state": {
      "enum": [
        "aborted",
        "completed",
        "failed",
        "pending",
        "running"
      ],
      "type": "string"
    }
  }
}
