#!/usr/bin/env bash
set -euf -o pipefail

# Validate required environment variables
: "${GITHUB_TOKEN:?GITHUB_TOKEN is required}"
: "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
: "${GITHUB_REPOSITORY_OWNER:?GITHUB_REPOSITORY_OWNER is required}"
: "${VERSION_TAG:?VERSION_TAG is required}"

# Get the previous tag: the one before VERSION_TAG among the tags of its kind
PREVIOUS_TAG="$("$(git rev-parse --show-toplevel)/scripts/release_tags" \
  | awk -v tag="${VERSION_TAG}" '$0 == tag { print previous } { previous = $0 }')"

# Check if PREVIOUS_TAG is empty and exit with an error if so
if [[ -z "${PREVIOUS_TAG}" ]]; then
  echo "Error: No previous tag found. Exiting."
  exit 1
fi

# Echo PREVIOUS_TAG for debugging purposes
echo "Previous tag: ${PREVIOUS_TAG}"

# Define the GitHub API URL for the release
RELEASE_API_URL="https://api.github.com/repos/${GITHUB_REPOSITORY}/releases/tags/${VERSION_TAG}"

# Check if the release exists
HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -H "Authorization: token ${GITHUB_TOKEN}" "${RELEASE_API_URL}")

if [[ "$HTTP_STATUS" -eq 404 ]]; then
  # Release not found, so create a new release
  echo "Creating new GitHub release..."

  # GitHub exposes an endpoint to get the notes that --generate-notes would generate. We use that
  # to get the notes, then we amend them, and then we create the release, passing the edited notes back.

  # The notes GitHub itself would generate for this range. This endpoint creates nothing; it
  # only returns the text.
  if ! GENERATED_NOTES="$(gh api "repos/${GITHUB_REPOSITORY}/releases/generate-notes" \
    -f tag_name="${VERSION_TAG}" \
    -f previous_tag_name="${PREVIOUS_TAG}" \
    --jq '.body')"; then
    echo "Error: Failed to generate release notes" >&2
    exit 1
  fi

  # Amend the notes: every monorepo export entry becomes the changes it actually publishes
  NOTES_FILE=$(mktemp)
  trap 'rm -f "${NOTES_FILE}"' EXIT

  if ! "$(git rev-parse --show-toplevel)/scripts/expand_export_release_notes" \
    <<< "${GENERATED_NOTES}" > "${NOTES_FILE}"; then
    echo "Error: Failed to expand the monorepo export entries in the release notes" >&2
    exit 1
  fi

  # The terrat images of a semver release also carry the commit's date tag
  if [[ -n "${TERRAT_IMAGE_TAG:-}" && "${TERRAT_IMAGE_TAG}" != "${VERSION_TAG}" ]]; then
    printf "\n**Terrateam images** (terrat-oss, terrat-ee, terrat-ee-fips, ttm) are also tagged \`%s\`\n" \
      "${TERRAT_IMAGE_TAG}" >> "${NOTES_FILE}"
  fi

  if ! gh release create "${VERSION_TAG}" \
    --title "Release ${VERSION_TAG}" \
    --notes-file "${NOTES_FILE}" \
    --repo "${GITHUB_REPOSITORY}"; then
    echo "Error: Failed to create release" >&2
    exit 1
  fi
fi
