#!/usr/bin/env bash
set -euf -o pipefail

# Validate required environment variables
: "${VERSION_TAG:?VERSION_TAG is required}"

# The latest tag of VERSION_TAG's kind
LATEST_TAG="$("$(git rev-parse --show-toplevel)/scripts/release_tags" | tail -n1)"

([[ "${LATEST_TAG}" == "${VERSION_TAG}" ]] && echo "true") || echo "false"
