#!/usr/bin/env bash
# Write code/schema.sql: the schema of a fresh Stategraph database migrated to HEAD, a reference
# for humans and agents. It is generated, never edited: change a migration, then rerun this.
#
#   sg_dump_db_schema SGS_CLI           regenerate code/schema.sql
#   sg_dump_db_schema --check SGS_CLI   exit non-zero if code/schema.sql is stale
#
# SGS_CLI is the CLI whose `migrate` builds the schema. `make -C code db-schema` and
# `make -C code check-db-schema` build it and pass it.
#
# The migrations run in a scratch database on the PostgreSQL server named by DB_HOST, DB_PORT,
# DB_USER and DB_PASS, and the scratch database is dropped on exit, so the database in DB_NAME is
# never read or written. DB_USER needs the CREATEDB privilege.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCHEMA="$ROOT/code/schema.sql"

usage() {
  echo "usage: $0 [--check] SGS_CLI" >&2
  exit 2
}

check=false
if [ "${1:-}" = "--check" ]; then
  check=true
  shift
fi
[ $# -eq 1 ] || usage
sgs_cli=$1

: "${DB_HOST:?DB_HOST must name the PostgreSQL server}"
: "${DB_PORT:?DB_PORT must be set}"
: "${DB_USER:?DB_USER must be set}"
: "${DB_PASS:?DB_PASS must be set}"
export PGHOST=$DB_HOST PGPORT=$DB_PORT PGUSER=$DB_USER PGPASSWORD=$DB_PASS

scratch="sg_schema_dump_$$_$RANDOM"
work=$(mktemp -d)
cleanup() {
  dropdb --if-exists "$scratch" || true
  rm -rf "$work"
}
trap cleanup EXIT

createdb "$scratch"

# Orchestration's FDW bridge and terrateam database are set up by `migrate` from the environment,
# not by a migration, so they are kept out of the schema.
if ! DB_NAME=$scratch STATEGRAPH_ORCHESTRATION_ENABLED=false STATEGRAPH_SILENT=true \
  "$sgs_cli" migrate >"$work/migrate.log" 2>&1; then
  cat "$work/migrate.log" >&2
  echo "migrate failed on the scratch database $scratch" >&2
  exit 1
fi

# pg_dump frames its output with a \restrict key drawn at random on every run; a fixed key keeps
# the file stable. The key guards a restore against crafted object names, and every name here
# comes from the migrations. The version lines are dropped so that a minor upgrade of the server
# or of pg_dump does not make the file stale.
{
  echo "-- GENERATED by scripts/sg_dump_db_schema from the migrations in code/src/sgs_migrations."
  echo "-- Do not edit: run \`make -C code db-schema\` after changing a migration."
  pg_dump --schema-only --no-owner --no-privileges --restrict-key=stategraph --dbname="$scratch" |
    sed -e '/^-- Dumped from database version /d' -e '/^-- Dumped by pg_dump version /{N;d;}'
} >"$work/schema.sql"

if $check; then
  if ! diff -u "$SCHEMA" "$work/schema.sql"; then
    echo "code/schema.sql is out of sync with the migrations." >&2
    echo 'Run `make -C code db-schema` and commit code/schema.sql.' >&2
    exit 1
  fi
else
  mv "$work/schema.sql" "$SCHEMA"
fi
