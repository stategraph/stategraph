#! /bin/sh

sleep 5

if [ "$DISABLE_IPV6" = "1" ]; then
  export IPV6_LISTEN=""
else
  export IPV6_LISTEN="listen [::]:8080;"
fi

if [ -z "$TERRAT_ACCESS_LOG" ]; then
    export TERRAT_ACCESS_LOG="off"
fi

if [ -z "$TERRATEAM_CLIENT_MAX_BODY_SIZE" ]; then
    export TERRATEAM_CLIENT_MAX_BODY_SIZE="100m"
fi

export TERRATEAM_UI_ANALYTICS=$TERRATEAM_UI_ANALYTICS
export TERRATEAM_UI_SUBSCRIPTION=$TERRATEAM_UI_SUBSCRIPTION
export TERRATEAM_MAINTENANCE=$TERRATEAM_MAINTENANCE
export TERRATEAM_MAINTENANCE_MESSAGE=$TERRATEAM_MAINTENANCE_MESSAGE
export TERRATEAM_UPGRADE_NUDGES=$TERRATEAM_UPGRADE_NUDGES

# Graceful-shutdown bound for the nginx workers. Must stay below
# runit-init's NGINX_SHUTDOWN_WAIT; see nginx.conf.template.
export NGINX_WORKER_SHUTDOWN_TIMEOUT="${NGINX_WORKER_SHUTDOWN_TIMEOUT:-35}"

mkdir -p /run/nginx
envsubst '$NGINX_WORKER_SHUTDOWN_TIMEOUT $TERRAT_UI_BASE $IPV6_LISTEN $TERRAT_ACCESS_LOG $TERRATEAM_CLIENT_MAX_BODY_SIZE $TERRATEAM_UI_ANALYTICS $TERRATEAM_UI_SUBSCRIPTION $TERRATEAM_MAINTENANCE $TERRATEAM_MAINTENANCE_MESSAGE $TERRATEAM_UPGRADE_NUDGES' < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf
exec /usr/sbin/nginx -c /etc/nginx/nginx.conf
