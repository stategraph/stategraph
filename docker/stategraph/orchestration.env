# Orchestration on, with the FDW role passwords initdb/ creates. The repo-root
# .env overrides each of them; STATEGRAPH_ORCHESTRATION_ENABLED=false there
# turns orchestration off.
STATEGRAPH_ORCHESTRATION_ENABLED=true
STATEGRAPH_FDW_PASSWORD=stategraph_mql
STATEGRAPH_FDW_PROVISIONER_PASSWORD=stategraph_provisioner
